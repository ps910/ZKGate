/**
 * ShroudWar — On-Chain Fog-of-War 1v1 Strategy Game
 * Built for Midnight Network (Level 4)
 *
 * Implements shielded unit positions, Chebyshev movement proofs,
 * challenge-response scouting, and proximity combat resolution
 * using native Compact private state and disclose() semantics.
 */

pragma language_version >= 0.18.0;

import CompactStandardLibrary;

// ============================================================================
// Data Types
// ============================================================================

export struct Position {
  x: Uint<8>,
  y: Uint<8>
}

export struct ScoutChallenge {
  challenger: Bytes<32>,
  targetX: Uint<8>,
  targetY: Uint<8>,
  deadline: Uint<32>,
  resolved: Boolean
}

export struct CombatClaim {
  challenger: Bytes<32>,
  targetUnitId: Bytes<32>,
  claimedX: Uint<8>,
  claimedY: Uint<8>,
  deadline: Uint<32>,
  resolved: Boolean
}

// ============================================================================
// Public Ledger State
// ============================================================================

export ledger phase: Uint<8>; // 0 = Setup, 1 = Active, 2 = Ended
export ledger gridSize: Uint<8>; // Default 10
export ledger moveSpeed: Uint<8>; // Default 2 (Chebyshev)
export ledger combatRange: Uint<8>; // Default 1 (Adjacent including diagonal)
export ledger scoutWindow: Uint<32>; // Default 3 actions
export ledger players: Vector<2, Bytes<32>>; // Player public keys
export ledger unitCommitments: Map<Bytes<32>, Bytes<32>>; // unitId -> persistentCommit(Position, salt)
export ledger unitAlive: Map<Bytes<32>, Boolean>; // unitId -> isAlive
export ledger scoutChallenges: Map<Bytes<32>, ScoutChallenge>; // challengeId -> ScoutChallenge
export ledger scoutResults: Map<Bytes<32>, Boolean>; // challengeId -> isOccupied
export ledger combatClaims: Map<Bytes<32>, CombatClaim>; // claimId -> CombatClaim
export ledger actionCount: Counter; // Global action sequence counter
export ledger winner: Bytes<32>; // Winning player's public key

// ============================================================================
// Private Witness Declarations (executed client-side in TypeScript)
// ============================================================================

witness myPublicKey(): Bytes<32>;
witness getPosition(unitId: Bytes<32>): Position;
witness getSalt(unitId: Bytes<32>): Bytes<32>;
witness nextSalt(unitId: Bytes<32>): Bytes<32>;

// ============================================================================
// Pure Helpers
// ============================================================================

circuit absDiff(a: Uint<8>, b: Uint<8>): Uint<8> {
  if (a >= b) {
    return a - b;
  }
  return b - a;
}

// ============================================================================
// Circuits
// ============================================================================

/**
 * Initialize match parameters and players (Phase 1)
 */
export circuit initGame(
  playerA: Bytes<32>,
  playerB: Bytes<32>,
  grid: Uint<8>,
  speed: Uint<8>,
  range: Uint<8>,
  window: Uint<32>
): [] {
  assert(phase == 0, "Game already initialized");
  assert(grid >= 4 && grid <= 32, "Grid size must be between 4 and 32");
  assert(speed >= 1 && speed <= 5, "Move speed must be between 1 and 5");
  assert(range >= 1 && range <= 3, "Combat range must be between 1 and 3");

  players = [playerA, playerB];
  gridSize = grid;
  moveSpeed = speed;
  combatRange = range;
  scoutWindow = window;
  phase = 0; // Setup phase
}

/**
 * Start the active match phase once all units are registered
 */
export circuit startGame(): [] {
  assert(phase == 0, "Not in setup phase");
  phase = 1; // Active phase
}

/**
 * Register a unit with an initial private position commitment (Phase 2)
 */
export circuit registerUnit(unitId: Bytes<32>, startX: Uint<8>, startY: Uint<8>): [] {
  assert(phase == 0, "Not in setup phase");
  assert(startX < gridSize && startY < gridSize, "Start cell off grid");

  const salt = nextSalt(unitId);
  const commit = persistentCommit<Position>(Position { x: startX, y: startY }, salt);
  unitCommitments.insert(unitId, disclose(commit));
  unitAlive.insert(unitId, true);
}

/**
 * Move a unit: proves legal Chebyshev movement without disclosing coordinates (Phase 3)
 */
export circuit move(unitId: Bytes<32>, newX: Uint<8>, newY: Uint<8>): [] {
  assert(phase == 1, "Game not active");
  assert(unitAlive.lookup(unitId), "Unit is dead");

  const oldPos = getPosition(unitId);
  const oldSalt = getSalt(unitId);
  const oldCommit = persistentCommit<Position>(oldPos, oldSalt);
  assert(oldCommit == unitCommitments.lookup(unitId), "Stale position proof");

  assert(newX < gridSize && newY < gridSize, "Move leaves the grid");
  assert(absDiff(oldPos.x, newX) <= moveSpeed, "Exceeds move speed (x)");
  assert(absDiff(oldPos.y, newY) <= moveSpeed, "Exceeds move speed (y)");

  const newSalt = nextSalt(unitId);
  const newCommit = persistentCommit<Position>(Position { x: newX, y: newY }, newSalt);
  unitCommitments.insert(unitId, disclose(newCommit));
  actionCount.increment(1);
}

/**
 * Request scout on a target cell (Phase 4)
 */
export circuit requestScout(targetX: Uint<8>, targetY: Uint<8>): Bytes<32> {
  assert(phase == 1, "Game not active");
  assert(targetX < gridSize && targetY < gridSize, "Scout target off grid");

  const id = persistentHash<Vector<3, Field>>([
    targetX as Field,
    targetY as Field,
    actionCount.read() as Field
  ]);

  scoutChallenges.insert(id, ScoutChallenge {
    challenger: disclose(myPublicKey()),
    targetX: targetX,
    targetY: targetY,
    deadline: actionCount.read() + scoutWindow,
    resolved: false
  });

  actionCount.increment(1);
  return id;
}

/**
 * Respond to a scout challenge: discloses ONLY a boolean (occupied/not) (Phase 4)
 */
export circuit respondScout(challengeId: Bytes<32>, unitId: Bytes<32>): [] {
  const challenge = scoutChallenges.lookup(challengeId);
  assert(!challenge.resolved, "Challenge already resolved");

  const pos = getPosition(unitId);
  const salt = getSalt(unitId);
  const commit = persistentCommit<Position>(pos, salt);
  assert(commit == unitCommitments.lookup(unitId), "Stale position proof");

  const occupied: Boolean = (pos.x == challenge.targetX) && (pos.y == challenge.targetY);
  scoutResults.insert(challengeId, disclose(occupied));

  challenge.resolved = true;
  scoutChallenges.insert(challengeId, disclose(challenge));
  actionCount.increment(1);
}

/**
 * Forfeit an unanswered scout challenge past its deadline (Phase 6)
 */
export circuit forfeitScout(challengeId: Bytes<32>): [] {
  const challenge = scoutChallenges.lookup(challengeId);
  assert(!challenge.resolved, "Already resolved");
  assert(actionCount.read() > challenge.deadline, "Deadline has not elapsed");

  // Default rule: resolve as false and close challenge
  scoutResults.insert(challengeId, false);
  challenge.resolved = true;
  scoutChallenges.insert(challengeId, disclose(challenge));
}

/**
 * Claim combat against an opposing unit at a claimed cell (Phase 5)
 */
export circuit claimCombat(
  targetUnitId: Bytes<32>,
  claimedX: Uint<8>,
  claimedY: Uint<8>
): Bytes<32> {
  assert(phase == 1, "Game not active");
  assert(unitAlive.lookup(targetUnitId), "Target unit already dead");
  assert(claimedX < gridSize && claimedY < gridSize, "Claimed position off grid");

  const id = persistentHash<Vector<3, Field>>([
    targetUnitId as Field,
    claimedX as Field,
    claimedY as Field
  ]);

  combatClaims.insert(id, CombatClaim {
    challenger: disclose(myPublicKey()),
    targetUnitId: targetUnitId,
    claimedX: claimedX,
    claimedY: claimedY,
    deadline: actionCount.read() + scoutWindow,
    resolved: false
  });

  actionCount.increment(1);
  return id;
}

/**
 * Respond to combat claim: if in range, mutual destruction occurs (Phase 5)
 */
export circuit respondCombat(claimId: Bytes<32>, unitId: Bytes<32>): [] {
  const claim = combatClaims.lookup(claimId);
  assert(!claim.resolved, "Claim already resolved");
  assert(claim.targetUnitId == unitId, "Wrong unit for this claim");

  const pos = getPosition(unitId);
  const salt = getSalt(unitId);
  const commit = persistentCommit<Position>(pos, salt);
  assert(commit == unitCommitments.lookup(unitId), "Stale position proof");

  const inRange: Boolean =
    (absDiff(pos.x, claim.claimedX) <= combatRange) &&
    (absDiff(pos.y, claim.claimedY) <= combatRange);

  if (inRange) {
    unitAlive.insert(unitId, false);
  }

  claim.resolved = true;
  combatClaims.insert(claimId, disclose(claim));
  actionCount.increment(1);
}

/**
 * Forfeit an unanswered combat claim past its deadline (Phase 6)
 */
export circuit forfeitCombat(claimId: Bytes<32>): [] {
  const claim = combatClaims.lookup(claimId);
  assert(!claim.resolved, "Already resolved");
  assert(actionCount.read() > claim.deadline, "Deadline has not elapsed");

  // Non-responsive target is destroyed for failure to respond
  unitAlive.insert(claim.targetUnitId, false);
  claim.resolved = true;
  combatClaims.insert(claimId, disclose(claim));
}

/**
 * Check win condition and finalize game (Phase 7)
 */
export circuit checkWin(winnerPubKey: Bytes<32>): [] {
  assert(phase == 1, "Game not active");
  winner = disclose(winnerPubKey);
  phase = 2; // Ended phase
}
